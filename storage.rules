rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Guest checkout uploads slips without Firebase Auth.
    // Tokenized download URLs are used for viewing; read is open so
    // getDownloadURL / admin previews work for unauthenticated sessions too.
    match /slips/{orderId}/{fileName} {
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow read: if true;
    }

    // Admin uploads store assets (PromptPay QR, etc.)
    match /store/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
